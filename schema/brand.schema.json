{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ac-ustad/brand.schema.json",
  "title": "AC Ustad brand data file (brand.json or <series>.json)",
  "description": "A data file is either brand metadata (has 'brand' + 'series') or a series code file (has 'brandId' + 'series' + 'codes').",
  "oneOf": [
    { "$ref": "#/definitions/brandFile" },
    { "$ref": "#/definitions/seriesFile" }
  ],
  "definitions": {
    "lang": {
      "type": "object",
      "required": ["en", "ur"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ur": { "type": "string", "minLength": 1, "description": "Roman Urdu (Latin script). Primary display language." }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "title", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "service_manual",
            "user_manual",
            "official_support",
            "distributor_page",
            "retailer_page",
            "video",
            "forum",
            "technician_note",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "severity": {
      "enum": ["info", "self_clear", "check_restart", "stop_pro", "danger"]
    },
    "confidence": {
      "enum": ["high", "medium", "low"],
      "description": "high = official source or 2+ agreeing sources; medium = 1 solid source; low = single weak/video/tag evidence or meaning unverified"
    },
    "display": {
      "enum": ["indoor", "outdoor", "remote", "controller", "led_blink", "unknown"]
    },
    "category": { "enum": ["ac", "inverter"] },
    "code": {
      "type": "object",
      "required": ["code", "aliases", "title", "meaning", "causes", "solutions", "severity", "display", "isFault", "source"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "title": { "$ref": "#/definitions/lang" },
        "meaning": { "$ref": "#/definitions/lang" },
        "causes": {
          "type": "array",
          "items": { "$ref": "#/definitions/lang" }
        },
        "solutions": {
          "type": "array",
          "items": { "$ref": "#/definitions/lang" }
        },
        "severity": { "$ref": "#/definitions/severity" },
        "display": { "$ref": "#/definitions/display" },
        "isFault": { "type": "boolean" },
        "relatedCodes": { "type": "array", "items": { "type": "string" } },
        "blinkPattern": { "type": "string" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "notes": {
          "$ref": "#/definitions/lang",
          "description": "Source conflicts, model-dependence warnings, alternate meanings"
        },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "seriesMeta": {
      "type": "object",
      "required": ["id", "name", "category", "unitType", "modelPatterns"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/definitions/category" },
        "unitType": {
          "enum": [
            "split",
            "floor_standing",
            "cassette",
            "ducted",
            "window",
            "solar_hybrid_ac",
            "hybrid_inverter",
            "on_grid_inverter",
            "off_grid_inverter",
            "ups",
            "vfd",
            "generic"
          ]
        },
        "modelPatterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "brandFile": {
      "type": "object",
      "required": ["schemaVersion", "brand", "series"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "brand": {
          "type": "object",
          "required": ["id", "name", "category", "updatedAt"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "name": { "type": "string", "minLength": 1 },
            "category": { "$ref": "#/definitions/category" },
            "country": { "type": "string" },
            "website": { "type": "string" },
            "notes": { "type": "string" },
            "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "sourceNotes": { "type": "string" }
          }
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "file"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "name": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.json$" },
              "models": { "type": "array", "items": { "type": "string" } },
              "codeCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "seriesFile": {
      "type": "object",
      "required": ["schemaVersion", "brandId", "series", "codes"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "brandId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "series": { "$ref": "#/definitions/seriesMeta" },
        "codes": {
          "type": "array",
          "items": { "$ref": "#/definitions/code" }
        }
      }
    }
  }
}
