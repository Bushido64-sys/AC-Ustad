<?xml version="1.0" encoding="utf-8"?>
<!--
  The 8.8 MB knowledge base is regenerated by the app on first launch, so it must not be
  backed up. Only the technician's saved codes are worth restoring.

  Listing an <include> already excludes everything not listed, so no <exclude> entries are
  needed - and adding them is an error, because an excluded path that is not inside an
  included path is contradictory. Lint check: FullBackupContent.
-->
<full-backup-content>
    <include domain="database" path="ac_ustad_favourites.db" />
    <include domain="sharedpref" path="ac_ustad_settings.xml" />
</full-backup-content>
