<?xml version="1.0" encoding="utf-8"?>
<!-- The 8.8 MB database is rebuilt from the app itself on first launch, so it is
     excluded from backup. Only the user's saved list is worth restoring. -->
<full-backup-content>
    <include domain="database" path="ac_ustad_favourites.db" />
    <exclude domain="database" path="kb.sqlite" />
    <exclude domain="file" path="kb.sqlite" />
</full-backup-content>
