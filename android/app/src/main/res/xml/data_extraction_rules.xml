<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. As with backup_rules.xml, an <include> already excludes
  everything else, so there are no <exclude> entries: the knowledge base in assets/ is
  rebuilt by the app and must not be copied.

  The saved list is genuinely worth keeping: it is the one thing the user created.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="ac_ustad_favourites.db" />
        <include domain="sharedpref" path="ac_ustad_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ac_ustad_favourites.db" />
        <include domain="sharedpref" path="ac_ustad_settings.xml" />
    </device-transfer>
</data-extraction-rules>
