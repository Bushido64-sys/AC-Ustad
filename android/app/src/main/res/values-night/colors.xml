<?xml version="1.0" encoding="utf-8"?>
<!-- DARK theme. The canvas is blue-black #0B1116, NOT #000000: pure black is on the
     anti-slop ban list (RULE 10) and the blue cast reads as designed. -->
<resources>
    <color name="blue_300">#6FB4DE</color>  <!-- dark-mode accents and borders: 8.37:1 on canvas -->
    <color name="blue_400">#4A9DD0</color>
    <color name="blue_500">#2A86C7</color>  <!-- dark-mode link text 4.82:1 -->
    <color name="blue_600">#1668A8</color>  <!-- primary fill, white text 5.87:1 -->
    <color name="blue_800">#0D4C79</color>

    <color name="ink">#F2F6F8</color>         <!-- 17.46:1 on canvas -->
    <color name="ink_muted">#9FB3C0</color>   <!-- 8.76:1 -->
    <color name="ink_invert">#0B1F2A</color>

    <color name="canvas">#0B1116</color>
    <color name="surface">#141D25</color>
    <color name="surface_alt">#1B2833</color>
    <color name="hairline">#24333F</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- The alert hue lifts for a dark surface: #FF6A3D with ink text = 6.67:1 -->
    <color name="signal_tint">#3A1A10</color>
    <color name="signal_tint_3">#3A1A10</color>
    <color name="signal_mid">#FFB49E</color>
    <color name="signal_deep">#FF6A3D</color>
    <color name="signal_stop">#FFB49E</color>
    <color name="signal_danger_border">#FFB49E</color>
    <color name="neutral_fill">#24333F</color>
</resources>
