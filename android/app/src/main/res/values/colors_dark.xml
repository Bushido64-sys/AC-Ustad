<?xml version="1.0" encoding="utf-8"?>
<!--
  THE DARK PALETTE. See colors.xml for why these are ordinary resources in the default folder
  rather than a values-night/ folder - briefly, because it cost a real bug: a night-qualified
  folder is chosen by the PHONE, so it cannot honour a user who chose Light on a dark phone.

  Names are the guide's, from design_tokens.xml, which already distinguishes these:
      ink              / ink_invert
      ink_muted        / ink_muted_dark
      canvas           / canvas_dark
      surface          / surface_dark
      surface_alt      / surface_alt_dark
      hairline         / hairline_dark
      signal_deep      / signal_on_dark
      signal_tint      / signal_dark_surface
      signal_mid       / signal_dark_text
      neutral_fill     / neutral_fill_dark

  That naming is not perfectly regular - some are a _dark suffix and three signal ones are named
  for what they are - and it is kept anyway, because design_tokens.xml is the single authority
  and a second, tidier convention in the app would be a third place to look. PHASE_11's token
  drift is where that gets settled.
-->
<resources>
    <!-- Dark text. ink_invert is the guide's name for "ink on a dark background" - it is not
         an inverted-white swatch, it is simply the dark-mode text colour. -->
    <color name="ink_invert">#F2F6F8</color>      <!-- 17.46:1 on canvas -->
    <color name="ink_muted_dark">#9FB3C0</color>  <!-- 8.76:1 -->

    <!-- Dark canvas and surfaces. The canvas is blue-black #0B1116, NOT #000000: pure black is
         on the anti-slop ban list (RULE 10) and the blue cast reads as designed. -->
    <color name="canvas_dark">#0B1116</color>
    <color name="surface_dark">#141D25</color>
    <color name="surface_alt_dark">#1B2833</color>
    <color name="hairline_dark">#24333F</color>

    <!-- The alert hue lifts for a dark surface: #FF6A3D with ink text = 6.67:1. This is why the
         dark danger fill is a different token from the light one and not just a dimmer copy. -->
    <color name="signal_on_dark">#FF6A3D</color>   <!-- dark danger fill -->
    <color name="signal_dark_surface">#3A1A10</color> <!-- dark tinted chip surface -->
    <color name="signal_dark_text">#FFB49E</color>   <!-- on signal_dark_surface, 9.19:1 -->
    <color name="neutral_fill_dark">#24333F</color>  <!-- self_clear chip, dark -->
</resources>
