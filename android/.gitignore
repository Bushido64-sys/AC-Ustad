# Gradle / Android.
# These rules are duplicated in the repository root .gitignore on purpose: they must hold
# even if this directory is ever extracted on its own.

# Gradle / Android
.gradle/
build/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class

# The SDK is installed by CI, never checked in
/android-sdk/

# REAL AdMob IDs. The repository is public: ads.properties and the owner's
# scratch copy of the IDs must never be committed. Debug builds use Google's
# demo units and never read this file.
ads.properties
Unit-ID.txt
release.keystore
*.p12
*.p12.b64

# IDE
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Keep the wrapper: it is how the project builds anywhere, including CI
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*~
