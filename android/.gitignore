# Gradle / Android.
# These rules are duplicated in the repository root .gitignore on purpose: they must hold
# even if this directory is ever extracted on its own.

# Gradle / Android
.gradle/
build/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class

# The SDK is installed by CI, never checked in
/android-sdk/

# IDE
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Keep the wrapper: it is how the project builds anywhere, including CI
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*~
